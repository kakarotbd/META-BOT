# Copy to .env for the desktop GUI. Add the same values as Railway Variables.
DISCORD_BOT_TOKEN=replace_with_discord_bot_token
BOT_ENCRYPTION_KEY=replace_with_fernet_key
BOT_CONTROL_ID=production

CLOUDFLARE_ACCOUNT_ID=replace_with_cloudflare_account_id
D1_DATABASE_ID=replace_with_d1_database_id
D1_API_TOKEN=replace_with_cloudflare_d1_api_token
R2_ENDPOINT=https://replace_with_account_id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace_with_r2_access_key_id
R2_SECRET_ACCESS_KEY=replace_with_r2_secret_access_key
R2_BUCKET_NAME=replace_with_private_bucket_name

ADMIN_USER_ID=replace_with_discord_admin_user_id
ALLOWED_GUILD_ID=replace_with_discord_server_id
